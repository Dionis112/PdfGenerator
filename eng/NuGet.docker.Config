<configuration>
  <packageSources>
    <clear />
    <add key="mvp-local" value="../artifacts/packages" />
    <add key="dependencies" value="/root/.nuget/packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="mvp-local"><package pattern="PdfGenerator*" /></packageSource>
    <packageSource key="dependencies"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
