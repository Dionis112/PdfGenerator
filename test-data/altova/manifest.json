{
  "schemaVersion": 1,
  "namespaceUri": "http://www.altova.com/xslt-extensions",
  "baselineStatus": "not-captured",
  "profiles": {
    "legacy-general": {
      "source": "https://www.altova.com/documents/2012/AltovaXMLRep.pdf",
      "xsltVersion": "2.0"
    },
    "legacy-charts": {
      "source": "https://www.altova.com/documents/2012/AltovaXMLRep.pdf",
      "xsltVersion": "2.0",
      "requires": "AltovaXML Enterprise or Reporting chart engine"
    },
    "modern-datetime": {
      "source": "https://www.altova.com/manual/XMLSpy/spyenterprise/fxaltova_xpxqdatetime.html",
      "xsltVersion": "3.0",
      "requires": "Engine supporting the documented Altova XPath 3.1 extensions; not a claim of AltovaXML 2012 support"
    },
    "legacy-negative": {
      "source": "https://www.altova.com/documents/2012/AltovaXMLRep.pdf",
      "xsltVersion": "2.0",
      "requires": "evaluate must be registered; unknown extension is not the expected failure"
    },
    "legacy-xbrl": {
      "source": "https://www.altova.com/documents/2012/AltovaXMLRep.pdf",
      "xsltVersion": "2.0",
      "requires": "Altova engine with XBRL support and an XML catalog or network access for standard XBRL 2.1 schemas"
    }
  },
